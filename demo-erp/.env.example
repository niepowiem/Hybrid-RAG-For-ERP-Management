# Adres widziany przez backend demo-erp. Dla tunelu SSH z komputera lokalnego:
CRM_CLASSIFIER_URL=http://127.0.0.1:8101/classify-email
CRM_CLASSIFIER_HEALTH_URL=http://127.0.0.1:8101/health
CRM_AI_API_KEY=zmien-na-dlugi-losowy-sekret
CRM_AI_TIMEOUT_MS=5000
CRM_AI_CLASSIFY_TIMEOUT_MS=5000
CRM_AI_HEALTH_TIMEOUT_MS=3000

# Kontrakt modelu - automatyczna klasyfikacja działa tylko przy pełnej zgodności.
CRM_EXPECTED_CLASSIFIER_SERVICE=crm-email-classifier
CRM_EXPECTED_ENCODER_NAME=stacking:minilm+e5-base+bge-m3
CRM_EXPECTED_MODEL_VERSION=stacking-crm-v1-dgx
CRM_EXPECTED_EMBEDDING_DIMENSION=3
CRM_EXPECTED_NORMALIZE_EMBEDDINGS=true
CRM_EXPECTED_PREPROCESSING_VERSION=2

# Drugi etap: Ollama na DGX. Pozostaw wyłączony do czasu wyboru modelu.
# CRM_OLLAMA_URL=http://127.0.0.1:11434
# CRM_OLLAMA_MODEL=wybrany-model:tag
